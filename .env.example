DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEFAULT_MODEL=deepseek-v4-flash

# 公网实例在进程环境设置 BRAIPEN_PUBLIC_MODE=1（此开关不从 .env 读取）
# 仅开放 /api/health、/api/capabilities 和 /api/compute/*
BRAIPEN_PUBLIC_MODE=0

# Custom安全出口：在进程环境设置服务器自身公网/NAT/IPv6地址，逗号分隔。
# 缺失时Custom fail-closed，官方预设仍可用。不要填写密钥。
# BRAIPEN_SELF_ADDRESSES=203.0.113.10,2001:db8::10
